{
  "title": "CRM Ticket Gateway (RED + saturación)",
  "uid": "crm-ticket-gateway",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "crm",
    "go",
    "slo"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate: requests/s por ruta",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors: % 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])),1e-9)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration: p50/p95/p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Protección: rate limit y load shedding",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ratelimit_rejected_total[1m]))",
          "legendFormat": "429 rate limit"
        },
        {
          "refId": "B",
          "expr": "rate(loadshed_rejected_total[1m])",
          "legendFormat": "503 shed"
        },
        {
          "refId": "C",
          "expr": "loadshed_concurrency_limit",
          "legendFormat": "límite AIMD"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Caché e idempotencia",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(cache_requests_total[1m]))",
          "legendFormat": "cache {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(idempotency_requests_total[1m]))",
          "legendFormat": "idem {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cola: profundidad por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "queue_depth",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox: pendientes y antigüedad",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_pending_events",
          "legendFormat": "pendientes"
        },
        {
          "refId": "B",
          "expr": "outbox_oldest_pending_age_seconds",
          "legendFormat": "antigüedad (s)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Circuit breakers (0 cerrado, 1 semi, 2 abierto)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "circuit_breaker_state",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Downstream por resultado",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, result) (rate(downstream_requests_total[1m]))",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Triage: agente vs fallback",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(triage_results_total[1m]))",
          "legendFormat": "{{source}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(triage_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 (s)"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker: p99 por tipo",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, type) (rate(queue_handler_duration_seconds_bucket[5m])))",
          "legendFormat": "{{type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (event) (rate(queue_messages_total[1m]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Saturación: pool DB y en vuelo",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_in_use",
          "legendFormat": "db pool"
        },
        {
          "refId": "B",
          "expr": "http_requests_in_flight",
          "legendFormat": "en vuelo"
        },
        {
          "refId": "C",
          "expr": "tickets_stored",
          "legendFormat": "tickets"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}